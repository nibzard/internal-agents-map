---
// ABOUTME: Shared entry sections ordered by the collection reading profile.
import Claim from './Claim.astro';
import ClaimAliases from './ClaimAliases.astro';
import Arrowed from './Arrowed.astro';
import Icon from './Icon.astro';
import SourceMarks from './SourceMarks.astro';
import { showQuestion, type EntryView } from '../lib/entry-view';
interface Props { entry: EntryView; section: 'workflow' | 'people' | 'implementation' }
const { entry, section } = Astro.props;
const hasHowItWorks = entry.workflowClaims.length > 0;
---
{section === 'workflow' && <>
    {showQuestion(entry, 'workflow') && (
      <section class="entry-section" id="how-it-works" aria-labelledby="how-it-works-title">
        <h2 id="how-it-works-title">{entry.profile.workflow}</h2>
        {hasHowItWorks ? (
          <>
            <p class="section-note">
              {entry.workflowScope ? `${entry.workflowScope.replace(/[.!?]$/, '')}.` : 'The workflow the sources report for this implementation.'}
            </p>
            <div class="step-panel">
              {entry.workflowClaims.map((claim) => <Claim claim={claim} />)}
            </div>
          </>
        ) : entry.coverageQuestions.workflow && (
          <p class="review-state" data-state={entry.coverageQuestions.workflow.state}><strong>{entry.coverageQuestions.workflow.stateLabel}{entry.coverageQuestions.workflow.note && ':'}</strong>{entry.coverageQuestions.workflow.note && ` ${entry.coverageQuestions.workflow.note}`}</p>
        )}
      </section>
    )}

</>}
{section === 'people' && <>
    {(entry.isSupportingSystem || showQuestion(entry, 'human_involvement')) && <section class="entry-section" id="human-involvement" aria-labelledby="human-involvement-title">
      <h2 id="human-involvement-title">{entry.profile.people}</h2>
      {!entry.isSupportingSystem && <p class="section-note">
        People review, approve, or guide the agent’s work here.
      </p>}
      {!entry.isSupportingSystem && entry.coverageQuestions.human_involvement?.note && (
        <p class="review-state" data-state={entry.coverageQuestions.human_involvement.state}><strong>{entry.coverageQuestions.human_involvement.stateLabel}:</strong> {entry.coverageQuestions.human_involvement.note}</p>
      )}
      {!entry.isSupportingSystem && entry.operatingModels.length > 0 && (
        <ul class="scope-list">
          {entry.supervisionLevels.map((level) => (
            <li class="level-card" data-level={level.level ?? 'unknown'}>
              <div class="level-head">
                <div>
                  <p class="level-eyebrow">Supervision level</p>
                  <p class="level-name">{level.label}</p>
                  {level.attention && <p class="level-attention">{level.attention}</p>}
                </div>
                {level.level !== null && (
                  <p class="level-number">
                    <span aria-hidden="true">{level.level}<span class="level-scale">/5</span></span>
                    <span class="visually-hidden">Level {level.level} of 5</span>
                  </p>
                )}
              </div>
              <ul class="level-scopes">
                {/* The scope line stands in for its operating-model claim. The evidence
                    ledger links to its anchor and keeps its provenance, confidence, and date. */}
                {level.scopes.map(({ scope, claim }) => (
                  <li class="scope-line" id={claim?.anchor} data-claim-id={claim?.id}>
                    {claim && <ClaimAliases claim={claim} />}
                    <Icon name="person" />
                    <span><Arrowed text={scope} />{claim && <SourceMarks citations={claim.supporting} />}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )}
      {!entry.isSupportingSystem && <p class="section-note"><a href="/definitions#supervision">How supervision levels work</a></p>}
      {entry.isSupportingSystem && entry.architectureRows.some((row) => row.field === 'architecture.credentials' && row.claim) && <p>See <a href={`#${entry.architectureRows.find((row) => row.field === 'architecture.credentials')?.claim?.anchor}`}>documented credential and access boundaries</a> in the architecture above. Scoped human-review assessments for individual uses remain in research details.</p>}
      {entry.isSupportingSystem && !entry.architectureRows.some((row) => row.field === 'architecture.credentials' && row.claim) && <p class="review-state">No separate access-control assessment is recorded.</p>}
    </section>}

</>}
{section === 'implementation' && <>
    <section class="entry-section" id="implementation" aria-labelledby="implementation-title">
      <h2 id="implementation-title">{entry.profile.implementation}</h2>
      <dl class="architecture">
        {entry.architectureRows.map((row) => (
          <>
            <dt>{row.label}</dt>
            {row.claim ? (
              <dd id={row.claim.anchor} data-claim-id={row.claim.id}>
                <ClaimAliases claim={row.claim} />
                {row.field === 'architecture.interfaces' ? <>
                  {row.note && <p class="interface-note">{row.note}</p>}
                  <div class="interface-values">
                    <ul class="term-list" role="list">
                      {entry.interfaces.map((item) => <li><span>{item.id}</span></li>)}
                    </ul>
                    <SourceMarks citations={row.claim.supporting} />
                  </div>
                </> : <>
                  {row.claim.text}
                  <SourceMarks citations={row.claim.supporting} />
                  {row.note && <span class="architecture-note">{row.note}</span>}
                </>}
                {row.claim.caveats.length > 0 && (
                  <span class="architecture-caveats">
                    {row.claim.caveats.map((caveat) => (
                      <span>{caveat.label}: {caveat.value}</span>
                    ))}
                  </span>
                )}
              </dd>
            ) : (
              <dd class="is-unreported">
                {row.state ? <><strong>{row.state === 'not-applicable' ? 'Not applicable' : row.state === 'not-reviewed' ? 'Not reviewed' : 'Not reported'}</strong>{row.note && <span>{row.note}</span>}</> : 'N/A'}
              </dd>
            )}
          </>
        ))}
      </dl>
      {entry.mechanismClaims.length > 0 && (
        <>
          <h3>Mechanisms</h3>
          {entry.mechanismClaims.map((claim) => <Claim claim={claim} />)}
        </>
      )}
    </section>

</>}
