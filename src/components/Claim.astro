---
// ABOUTME: Renders one normalized claim with its citations and its qualifications.
// ABOUTME: Caveats and conflicts stay in the initial HTML, beside the statement.
import Arrowed from './Arrowed.astro';
import ClaimAliases from './ClaimAliases.astro';
import Icon from './Icon.astro';
import SourceMarks from './SourceMarks.astro';
import type { ClaimView } from '../lib/entry-view';
import { observedPhrase } from '../lib/labels';

interface Props {
  claim: ClaimView;
  /** A mark that leads the row, where a group of claims reads as a list. */
  mark?: 'circle-check' | 'person';
  /** Hide the field label when a section heading already names the claim group. */
  showLabel?: boolean;
  /** Name the kind of the statement where a group holds more than one kind. */
  showKind?: boolean;
}

const { claim, showLabel = true, showKind = false, mark } = Astro.props;
/**
 * The observation date reads as a sentence rather than a table row. It keeps the
 * recorded value, which the site checker expects to find on the page verbatim.
 */
const OBSERVED = 'Observation date';
const observed = claim.caveats.find((caveat) => caveat.label === OBSERVED) ?? null;
const tabled = claim.caveats.filter((caveat) => caveat.label !== OBSERVED);
const attribution =
  claim.kind === 'opinion' && claim.provenanceLabel === 'Reported'
    ? 'Reported opinion'
    : claim.provenanceLabel === 'Catalog judgment'
      ? 'Catalog interpretation'
      : null;
// Claim text is catalog wording, not the words of the source, so no claim,
// the headline included, shows quotation marks.
---
<article class:list={['claim', mark && 'claim-marked']} id={claim.anchor} data-claim-id={claim.id}>
  <ClaimAliases claim={claim} />
  {mark && <Icon name={mark} />}
  {showLabel && (
    <span class="claim-label">
      {claim.label}{showKind && <span class="claim-kind"> ({claim.kindLabel.toLowerCase()})</span>}
    </span>
  )}
  <p class="claim-text">
    {attribution && <><span class="claim-attribution">{attribution}:</span>{' '}</>}
    <Arrowed text={claim.text} />
    <SourceMarks citations={claim.supporting} />
  </p>
  {claim.contradicting.length > 0 && (
    <div class="conflict">
      <strong>Conflicting evidence</strong>
      <p>
        Sources disagree about this statement. See the conflicting sources:{' '}
        {claim.contradicting.map((citation, index) => (
          <>{index > 0 && ', '}<a href={`#${citation.anchor}`}>{citation.number}</a></>
        ))}.
      </p>
    </div>
  )}
  {tabled.length > 0 && (claim.isMetric ? (
    <dl class="caveats caveats-columns">
      {tabled.map((caveat) => (
        <>
          <dt>{caveat.label}</dt>
          <dd>{caveat.value}</dd>
        </>
      ))}
    </dl>
  ) : (
    tabled.map((caveat) => <p class="caveat-note">{caveat.value}</p>)
  ))}
  {claim.qualification && <p class="qualification">{claim.qualification}</p>}
  {observed && <p class="observed">Observed {observedPhrase(observed.value)}</p>}
</article>
